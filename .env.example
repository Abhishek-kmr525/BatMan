ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./data/kalshi_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO=true
# When true, real Kalshi data is read but orders are simulated locally (no real $).
# When false, orders are sent to Kalshi for real money fills.
KALSHI_PAPER_MODE=true

KNOWLEDGE_PDF_DIR=/Volumes/Personal/MetaTrade/Knowledge PDF
DATABASE_URL=sqlite:///./data/amta.db
CHROMA_DIR=./data/chroma

ANALYZER_PROVIDER=local
LOCAL_ANALYZER_USE_RAG=false
GEMINI_REVIEW_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MIN_SCORE=85
GEMINI_DAILY_LIMIT=10
CLAUDE_MODEL=claude-sonnet-4-5-20250929
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3

# External intel layer (free/public sources)
INTEL_FEATURES_ENABLED=true
INTEL_USE_GDELT=true
INTEL_USE_GUARDIAN=true
INTEL_USE_FRED=true
INTEL_USE_BLS=true
GUARDIAN_API_KEY=test
FRED_API_KEY=
INTEL_REQUEST_TIMEOUT_SECONDS=12
INTEL_CACHE_TTL_SECONDS=600
INTEL_GDELT_MIN_INTERVAL_SECONDS=6
INTEL_MIN_FRESHNESS=0.22
INTEL_MIN_NEWS_ITEMS=2
INTEL_STRICT_SKIP=true
QUICK_EXPIRY_ALWAYS_ON=false
QUICK_EXPIRY_MIN_SECONDS=60
QUICK_EXPIRY_MAX_SECONDS=600

# Polymarket (phase-1 paper bot)
POLYMARKET_PAPER_MODE=true
POLYMARKET_SCAN_INTERVAL_SECONDS=30
POLYMARKET_TRADE_AMOUNT_USD=1.00
POLYMARKET_MAX_OPEN_POSITIONS=8
POLYMARKET_MIN_SCORE=65
POLYMARKET_MIN_TIME_TO_CLOSE_SECONDS=60
POLYMARKET_MAX_TIME_TO_CLOSE_SECONDS=86400
POLYMARKET_STARTING_BALANCE=20.00
POLYMARKET_MAX_DAILY_LOSS_USD=6.00

KALSHI_MAX_DAILY_LOSS_USD=15.00
KALSHI_LIVE_ENABLED=false
POLYMARKET_LIVE_ENABLED=false
LIVE_MODE_CONFIRM_PASSCODE=9472
LIVE_CANARY_ENABLED=true
KALSHI_CANARY_MAX_ORDER_USD=2.00
KALSHI_CANARY_MAX_NEW_TRADES_PER_DAY=5
KALSHI_CANARY_MAX_TOTAL_EXPOSURE_USD=10.00
POLYMARKET_CANARY_MAX_ORDER_USD=2.00
POLYMARKET_CANARY_MAX_NEW_TRADES_PER_DAY=5
POLYMARKET_CANARY_MAX_TOTAL_EXPOSURE_USD=10.00

BOT_SCAN_INTERVAL_SECONDS=30
TRADE_AMOUNT_USD=1.00
MIN_TRADE_SCORE=65
MIN_ENTRY_PRICE=0.03
MAX_CONCURRENT_POSITIONS=20
MAX_ANALYSES_PER_TICK=20
STARTING_BALANCE=10000.00

NEXT_PUBLIC_API_URL=http://localhost:4000
